# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
# Only the "Required" block is needed to boot the app locally. Everything else
# degrades gracefully when unset — the feature that depends on it is skipped.

# ─── Required ────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Drizzle (drizzle.config.ts and the app).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/memescope
# Better Auth signing secret. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base URL Better Auth builds its OAuth callbacks from.
BETTER_AUTH_URL=http://localhost:3000
# Public URL of the app, used for canonical links, share cards and emails.
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── OAuth providers ─────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google One Tap client ID (public, safe to expose).
NEXT_PUBLIC_ONE_TAP_CLIENT_ID=

# ─── Crypto data APIs ────────────────────────────────────────────────────────
# Solana token metadata and RPC.
HELIUS_API_KEY=
SOLANA_RPC_ENDPOINT=https://api.mainnet-beta.solana.com
SOLANA_WSS_ENDPOINT=wss://api.mainnet-beta.solana.com
# Market data providers.
CMC_API_KEY=
COINGECKO_API_KEY=
BIRDEYE_API_KEY=
ETHERSCAN_API_KEY=
# News aggregation.
CRYPTOPANIC_API_KEY=

# ─── Wallet ──────────────────────────────────────────────────────────────────
# WalletConnect / Reown project ID used by wagmi (public).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ─── Payments ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe payment links for the premium tiers (public).
NEXT_PUBLIC_PREMIUM_PAYMENT_LINK=
NEXT_PUBLIC_PREMIUM_PLUS_PAYMENT_LINK=
# Wallet address that receives x402 micropayments.
X402_RECEIVER_ADDRESS=

# ─── Cron & internal API auth ────────────────────────────────────────────────
# Secrets guarding the /api/cron/* routes scheduled in vercel.json.
CRON_SECRET=
CRON_API_KEY=
# Shared key for programmatic coin submission.
SUBMIT_API_KEY=

# ─── Notifications ───────────────────────────────────────────────────────────
# Transactional email (winner notifications, reminders).
RESEND_API_KEY=
# Discord webhooks: general notifications and Monday launch announcements.
DISCORD_WEBHOOK_URL=
DISCORD_LAUNCH_WEBHOOK_URL=
# X / Twitter posting credentials.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ─── Infrastructure ──────────────────────────────────────────────────────────
# Redis connection used for rate limiting. Falls back to in-memory when unset.
REDIS_URL=
# Image host for uploaded coin art (hostname only, e.g. abc123.ufs.sh).
NEXT_PUBLIC_UPLOADTHING_URL=

# ─── Bot protection ──────────────────────────────────────────────────────────
# Cloudflare Turnstile keys. The site key is public, the secret key is not.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Analytics ───────────────────────────────────────────────────────────────
PLAUSIBLE_URL=
PLAUSIBLE_SITE_ID=
PLAUSIBLE_API_KEY=

# ─── Misc ────────────────────────────────────────────────────────────────────
# Contact address shown in the UI and legal pages.
NEXT_PUBLIC_CONTACT_EMAIL=
# Outbound link used by the SEO article callout.
NEXT_PUBLIC_SEO_ARTICLE_LINK=
